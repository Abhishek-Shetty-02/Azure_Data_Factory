	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "shettyadf"
		},
		"TG_SQLDBtoADLS_properties_pl_sqldbtoadls_parameters_SchemaName": {
			"type": "string",
			"defaultValue": "SchemaName"
